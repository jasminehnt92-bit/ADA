# ADA — Variables d'environnement
# Copie ce fichier en .env

# URL d'Ollama (défaut: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Modèle Ollama à utiliser (défaut: llama3)
# Installe le modèle avec : ollama pull llama3
# Bons choix : llama3, mistral, llama3.2, gemma2
# OLLAMA_MODEL=llama3
