# ADA — Variables d'environnement
# Copie ce fichier en .env

# URL d'Ollama (défaut: http://localhost:11434)
# OLLAMA_URL=http://localhost:11434

# Modèle Ollama à utiliser (défaut: mistral)
# Installe le modèle avec : ollama pull mistral
# Bons choix : mistral, llama3.2, gemma2
# OLLAMA_MODEL=mistral
